<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JPA entities need a no-arg protected constructor; SpotBugs flags unused fields
         set only via reflection by Hibernate — a known false positive for this pattern. -->
    <Match>
        <Class name="~.*JpaEntity" />
        <Bug pattern="URF_UNREAD_FIELD" />
    </Match>
    <!-- Records used purely as DTOs sometimes trigger EI_EXPOSE_REP on collection
         fields even when the record constructor already defensively copies (Money,
         TimeRange, etc. do this explicitly where it matters). -->
    <Match>
        <Class name="~.*Dto" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Spring-managed collaborators are injected services, not mutable state
         exposed by the analyzed class. -->
    <Match>
        <Class name="~com\.company\.salonbooking\..*\.application\..*" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="~com\.company\.salonbooking\..*\.infrastructure\..*" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="~com\.company\.salonbooking\.infrastructure\..*" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="~com\.company\.salonbooking\..*\.interfaces\.rest\..*" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="com.company.salonbooking.infrastructure.security.JwtService" />
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>
</FindBugsFilter>